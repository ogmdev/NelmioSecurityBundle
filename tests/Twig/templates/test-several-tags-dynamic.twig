{% cspscript %}
<link rel="modulepreload" href="/assets/{{ entrypoint }}.js">
<script type="importmap">{"imports":{"{{ entrypoint }}":"/assets/{{ entrypoint }}.js"}}</script>
<script async src="/assets/es-module-shims.js"></script>
<script type="module">import '{{ entrypoint }}';</script>
{% endcspscript %}

{% cspstyle %}
<link rel="stylesheet" href="/assets/{{ entrypoint }}.css">
<style>body{ background: {{ color }}; }</style>
<style>p{ color: {{ color }}; }</style>
{% endcspstyle %}
